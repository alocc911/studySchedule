# Copy to .env for LOCAL development. Never commit credentials.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Chicago
DB_ENGINE=postgresql
POSTGRES_DB=study_schedule
POSTGRES_USER=study_schedule
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_X_FORWARDED_PROTO=false
