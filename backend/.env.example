# Copy to backend/.env; never commit .env or real participant information.
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

# Local MySQL from docker compose; replace credentials for any real deployment.
database.default.hostname = 127.0.0.1
database.default.database = study_schedule
database.default.username = study_schedule
database.default.password = local-only-change-me
database.default.DBDriver = MySQLi
database.default.port = 3306
