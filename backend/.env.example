# Copy to backend/.env; never commit .env or real participant information.
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

# Local MySQL from docker compose; replace credentials for any real deployment.
database.default.hostname = 127.0.0.1
database.default.database = study_schedule
database.default.username = study_schedule
database.default.password = local-only-change-me
database.default.DBDriver = MySQLi
database.default.port = 3306

# Shield admin sessions work only on the same origin as the PHP API.
# Production must use HTTPS, and SMTP/2FA must be configured before real participants.

# Transactional scheduling notifications (opt-in to actual sending).
# Use Mailpit for development: docker compose up -d db mailpit
# Do NOT enable live sending with example credentials or sample records.
notifications.enabled = false
notifications.fromEmail = 'scheduler@example.test'
notifications.fromName = 'Hospitality Research'
notifications.professorCopyEmail = ''
notifications.smtp.host = '127.0.0.1'
notifications.smtp.port = 1025
notifications.smtp.crypto = 'none'
notifications.smtp.username = ''
notifications.smtp.password = ''

# Production: configure a real SMTP hostname, TLS/SSL, verified credentials,
# and a from-address authorized by that provider, then set enabled=true.
